    "vite": "8.3.7",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/estree": "1.0.10",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
